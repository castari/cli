# =============================================================================
# Castari — environment variable template
# Copy this file to .env and fill in your values.
# =============================================================================

# ----------------------------------------------------------------------------
# llm-judge grader
# Required when any eval case uses { "type": "llm-judge" }
# ----------------------------------------------------------------------------

# Your API key for the LLM provider.
# Free Groq key (default provider): https://console.groq.com
CASTARI_API_KEY=your-api-key-here

# (Optional) Override the OpenAI-compatible base URL.
# Defaults to Groq. Other options:
#   Ollama (local, free): http://localhost:11434/v1
#   OpenAI:               https://api.openai.com/v1
# CASTARI_LLM_BASE_URL=https://api.groq.com/openai/v1

# (Optional) Model to use. Must be supported by your provider.
# Defaults to llama-3.1-8b-instant (fast & free on Groq).
# CASTARI_LLM_MODEL=llama-3.1-8b-instant
